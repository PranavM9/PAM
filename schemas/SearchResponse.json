{
  "$defs": {
    "SearchHit": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "doc_id": {
          "format": "uuid",
          "title": "Doc Id",
          "type": "string"
        },
        "doc_type": {
          "enum": [
            "episode",
            "fact",
            "project",
            "skill"
          ],
          "title": "Doc Type",
          "type": "string"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        },
        "snippet": {
          "maxLength": 500,
          "title": "Snippet",
          "type": "string"
        },
        "path": {
          "pattern": "^[^\\\\:]+$",
          "title": "Path",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "vector_rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Vector Rank"
        },
        "keyword_rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Keyword Rank"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Created At"
        }
      },
      "required": [
        "chunk_id",
        "doc_id",
        "doc_type",
        "scope",
        "title",
        "snippet",
        "path",
        "score",
        "vector_rank",
        "keyword_rank",
        "created_at"
      ],
      "title": "SearchHit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "query": {
      "title": "Query",
      "type": "string"
    },
    "agent": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "title": "Agent",
      "type": "string"
    },
    "hits": {
      "items": {
        "$ref": "#/$defs/SearchHit"
      },
      "title": "Hits",
      "type": "array"
    },
    "took_ms": {
      "title": "Took Ms",
      "type": "integer"
    }
  },
  "required": [
    "query",
    "agent",
    "hits",
    "took_ms"
  ],
  "title": "SearchResponse",
  "type": "object"
}
