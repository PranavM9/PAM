{
  "$defs": {
    "Source": {
      "enum": [
        "claude",
        "chatgpt",
        "gemini",
        "pam",
        "manual"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "agent": {
      "default": "default",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "title": "Agent",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "source_conversation_id": {
      "title": "Source Conversation Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "imported_at": {
      "format": "date-time",
      "title": "Imported At",
      "type": "string"
    },
    "message_count": {
      "minimum": 0,
      "title": "Message Count",
      "type": "integer"
    },
    "has_summary": {
      "title": "Has Summary",
      "type": "boolean"
    },
    "body_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Body Sha256",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "superseded_facts": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Superseded Facts",
      "type": "array"
    }
  },
  "required": [
    "id",
    "source",
    "source_conversation_id",
    "title",
    "created_at",
    "updated_at",
    "imported_at",
    "message_count",
    "has_summary",
    "body_sha256"
  ],
  "title": "EpisodeFrontmatter",
  "type": "object"
}
