{
  "$defs": {
    "AttachmentRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "file",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mime_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mime Type"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "AttachmentRef",
      "type": "object"
    },
    "RawMessage": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "user",
            "assistant",
            "system",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "attachments": {
          "items": {
            "$ref": "#/$defs/AttachmentRef"
          },
          "title": "Attachments",
          "type": "array"
        }
      },
      "required": [
        "role",
        "text"
      ],
      "title": "RawMessage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "title": {
      "title": "Title",
      "type": "string"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/RawMessage"
      },
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
    "title",
    "messages"
  ],
  "title": "LogEpisodeInput",
  "type": "object"
}
