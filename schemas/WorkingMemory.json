{
  "$defs": {
    "AttachmentRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "file",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mime_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mime Type"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "AttachmentRef",
      "type": "object"
    },
    "ModelSwitch": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "from_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "From Model"
        },
        "to_model": {
          "title": "To Model",
          "type": "string"
        }
      },
      "required": [
        "at",
        "from_model",
        "to_model"
      ],
      "title": "ModelSwitch",
      "type": "object"
    },
    "RawMessage": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "user",
            "assistant",
            "system",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "attachments": {
          "items": {
            "$ref": "#/$defs/AttachmentRef"
          },
          "title": "Attachments",
          "type": "array"
        }
      },
      "required": [
        "role",
        "text"
      ],
      "title": "RawMessage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "pattern": "^s_[0-9a-z]{12}$",
      "title": "Session Id",
      "type": "string"
    },
    "agent": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "title": "Agent",
      "type": "string"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "ended"
      ],
      "title": "Status",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "models_used": {
      "items": {
        "$ref": "#/$defs/ModelSwitch"
      },
      "title": "Models Used",
      "type": "array"
    },
    "goal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Goal"
    },
    "decisions": {
      "items": {
        "type": "string"
      },
      "title": "Decisions",
      "type": "array"
    },
    "open_questions": {
      "items": {
        "type": "string"
      },
      "title": "Open Questions",
      "type": "array"
    },
    "recent_turns": {
      "items": {
        "$ref": "#/$defs/RawMessage"
      },
      "maxItems": 8,
      "title": "Recent Turns",
      "type": "array"
    },
    "promoted_episode_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Promoted Episode Id"
    }
  },
  "required": [
    "session_id",
    "agent",
    "started_at",
    "updated_at"
  ],
  "title": "WorkingMemory",
  "type": "object"
}
