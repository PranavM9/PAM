{
  "$defs": {
    "ReadScope": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "default": false,
          "title": "All",
          "type": "boolean"
        },
        "project_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Project Ids",
          "type": "array"
        },
        "include_shared_facts": {
          "default": true,
          "title": "Include Shared Facts",
          "type": "boolean"
        },
        "include_own_memory": {
          "default": true,
          "title": "Include Own Memory",
          "type": "boolean"
        },
        "include_skills_from": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
            "type": "string"
          },
          "title": "Include Skills From",
          "type": "array"
        }
      },
      "title": "ReadScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "title": "Name",
      "type": "string"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "origin": {
      "enum": [
        "derived",
        "custom"
      ],
      "title": "Origin",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "read": {
      "$ref": "#/$defs/ReadScope"
    },
    "write": {
      "default": "own",
      "enum": [
        "none",
        "own",
        "shared"
      ],
      "title": "Write",
      "type": "string"
    },
    "tools": {
      "items": {
        "enum": [
          "get_context",
          "search_memory",
          "get_episode",
          "list_agents",
          "add_fact",
          "supersede_fact",
          "log_episode",
          "update_project",
          "add_skill",
          "update_working_memory"
        ],
        "type": "string"
      },
      "title": "Tools",
      "type": "array"
    },
    "default_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Default Model"
    },
    "token_budget": {
      "default": 2000,
      "maximum": 32000,
      "minimum": 256,
      "title": "Token Budget",
      "type": "integer"
    }
  },
  "required": [
    "name",
    "display_name",
    "origin",
    "created_at",
    "read",
    "tools"
  ],
  "title": "AgentManifest",
  "type": "object"
}
