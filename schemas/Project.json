{
  "$defs": {
    "Actor": {
      "enum": [
        "rule",
        "agent",
        "manual",
        "cluster"
      ],
      "title": "Actor",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "scope": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "title": "Scope",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "keywords": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "title": "Keywords",
      "type": "array"
    },
    "episode_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Episode Ids",
      "type": "array"
    },
    "origin": {
      "$ref": "#/$defs/Actor"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "dormant"
      ],
      "title": "Status",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "last_activity_at": {
      "format": "date-time",
      "title": "Last Activity At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "scope",
    "name",
    "origin",
    "created_at",
    "updated_at",
    "last_activity_at"
  ],
  "title": "Project",
  "type": "object"
}
